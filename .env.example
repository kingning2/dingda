# 叮答（DingDa）环境变量总表
#
# 用法：复制成同目录的 .env，按需取消注释并改值。.env 已被 .gitignore 忽略，本文件会提交。
#   复制：cp .env.example .env        （Windows: copy .env.example .env）
#
# 优先级：**真实环境变量 > .env > 代码内默认值**。
#   也就是说这里没写的项，代码里的默认值就是生效值；这里写了会覆盖默认值，
#   但已经被外部显式设置的变量不会被 .env 覆盖（便于 CI / E2E 临时覆盖）。
#
# 全表由 `grep -rn "os.getenv\|env::var\|process.env"` 扫出（55 项），
# 分四类：A 常用 / B 抓取调参 / C 集成与密钥 / D 构建与测试。
# 带「(壳注入)」的项由 Tauri 壳自动设置，**不要手写**。

# ===========================================================================
# A. 服务与运行时（改完要重启 Server）
#
# ⚠️ 生效范围：本文件由 **Python 侧**（Server / 工具子进程 / CLI）加载，
#    所以下面这些变量对 `python -m api`、`python -m tools.cli` 直接生效。
#    **桌面壳（Tauri）目前不读本文件**，它自己按同样的默认值决定端口并显式
#    传 `--port` 给 Server —— 即桌面模式下 DINGDA_HOST / DINGDA_PORT 由壳说了算，
#    在这里改不会影响壳。要让壳也读本文件，见文末「待办」。
# ===========================================================================

# 监听地址。默认 127.0.0.1（只本机可访问）。桌面模式下由壳决定。
#DINGDA_HOST=127.0.0.1

# 监听端口。默认 8787。桌面模式下由壳决定。
# 注意：E2E 固定用 8799（见 D 组），不要在这里改成 8799 免得和测试打架。
#DINGDA_PORT=8787

# 日志级别：DEBUG / INFO / WARNING / ERROR。默认 INFO。
#DINGDA_LOG_LEVEL=INFO

# 置 1/true/yes 开启 uvicorn 热重载（仅开发）。默认关。
#DINGDA_RELOAD=1

# 仓库根目录（Python uv workspace 根）。(壳注入)
# 壳在开发态指向仓库根、安装包指向可写工作副本；也是定位本文件与 .env 的锚点。
#DINGDA_SERVER_DIR=

# 是否用 uv 拉起 Server（0=不用，直接用 DINGDA_PYTHON）。(壳注入，默认 1)
#DINGDA_USE_UV=1

# uv 可执行文件路径。(壳注入，仅安装包)
#DINGDA_UV=

# 不用 uv 时的 Python 解释器路径；不设则回落 sys.executable。
#DINGDA_PYTHON=

# Server 的 HTTP 基址。**一般不要手写**：留空时会按 DINGDA_HOST/DINGDA_PORT 推导。
# 只有「外部调用方需要回打一个与监听地址不同的入口」（如反代）才显式设置。
#DINGDA_API_BASE=

# 内部：本次 Agent run 的 id，工具子进程靠它把直播帧推回对应 run。(壳/CLI 注入)
#DINGDA_AGENT_RUN_ID=

# ===========================================================================
# B. 抓取与浏览器（改完下次抓取生效）
# ===========================================================================

# 采集时有头启动（1/true/yes 开）。仅排障用，默认关（headless）。
#DINGDA_CRAWL_HEADED=0

# Camoufox 可执行文件路径。(壳注入；无壳时可用它手动指定)
#DINGDA_CAMOUFOX_EXE=

# Camoufox 安装目录（与 DINGDA_CAMOUFOX_EXE 二选一，前者优先）。
#DINGDA_CAMOUFOX_DIR=

# 是否启用自动拖滑块过风控：1 开（默认）/ 0 关。
# 关掉后前台会直接开有头窗口等人工，后台轮询则直接判失败。
#DINGDA_SLIDER_AUTO=1

# 自动滑块失败后，开有头窗口等人工过风控的秒数。默认 180。
#DINGDA_MANUAL_SLIDER_TIMEOUT_S=180

# 同一平台连续失败后的熔断冷却分钟数。默认 10。
#DINGDA_CIRCUIT_BREAK_MINUTES=10

# 闲鱼写操作（留言/关注等）每分钟上限。默认 1。
#DINGDA_WRITE_RPM=1

# 闲鱼 IM 长连接 token：留空则自动获取并缓存。默认空。
#DINGDA_IM_TOKEN=
# 上面那个 token 的有效期（秒），下限 60。默认 1800（30 分钟）。
#DINGDA_IM_TOKEN_TTL=1800

# 1688 AK 渠道标识。默认 dingda。
#ALI_1688_CHANNEL=dingda

# 抓取时自动修复失效 DOM 选择器：1 开（默认）/ 0 关。
#DINGDA_DOM_REPAIR=1
# 单次修复最多几轮。默认 3。
#DINGDA_DOM_REPAIR_ROUNDS=3
# 单次修复的候选选择器预算。默认 20。
#DINGDA_DOM_REPAIR_BUDGET=20
# 强制指定用哪个 Agent runtime 做修复（运维/测试用）。默认空=自动挑。
#DINGDA_DOM_REPAIR_RUNTIME=
# 修复现场试跑选择器时回打的地址（内部注入，一般不用管）。
#DINGDA_VALIDATE_URL=

# 上下文压缩（headroom）：1 开（默认）/ 0 关。
# 关掉工具输出体积会变大但更接近原始数据，排查「字段被压缩」类问题时可临时关。
#DINGDA_HEADROOM=1

# ===========================================================================
# C. 集成与密钥
# ===========================================================================

# 内置产品 Agent 的 LLM。默认模型 gpt-4o。
# 注意：走外部 CLI（opencode/codex/claude）时不读这三项，模型在界面里选。
#DINGDA_LLM_MODEL=gpt-4o
#DINGDA_LLM_BASE_URL=
#DINGDA_LLM_API_KEY=
# OPENAI_API_KEY 是 DINGDA_LLM_API_KEY 的兜底别名。
#OPENAI_API_KEY=

# 额外注入给外部 CLI 的 skill 目录（分号或逗号分隔）。默认空。
#DINGDA_SKILL_DIRS=

# ===========================================================================
# D. 前端联调 / 构建 / 测试
# ===========================================================================

# 前端默认的 API 地址（Vite 构建期注入）。留空则用 http://127.0.0.1:8787。
# 桌面壳经 IPC 拿 apiBaseUrl，不需要设这个。
#VITE_API_BASE_URL=http://127.0.0.1:8787

# `pnpm tauri dev` 监听的主机（局域网真机调试时设）。
#TAURI_DEV_HOST=

# --- E2E（本地手动跑，不挂 CI；见 e2e/README.md）---
# wdio 会自己读本文件（Node 内置 process.loadEnvFile），所以这组写在这里**是生效的**；
# 命令行上的临时覆盖依然优先（`DINGDA_E2E_PORT=8801 pnpm …`）。
# 被测端口。默认 8799。与别的会话并发跑时换一个（如 8801）避免抢端口。
#DINGDA_E2E_PORT=8799
# 壳二进制路径，相对仓库根。默认 target/debug/client.exe。
#DINGDA_E2E_APP_BINARY=target/debug/client.exe
# 用哪个 Agent 跑。默认 opencode。
#DINGDA_E2E_AGENT_ID=opencode
# 用哪个模型跑。不设则沿用界面里的用户偏好（**模型上下文不够会直接失败**）。
#DINGDA_E2E_MODEL_ID=
# 发给 Agent 的话。不设则用用例内置的「闲鱼搜露营椅，只调一次 search」。
#DINGDA_E2E_PROMPT=
# 至少要出几条商品才算通过。默认 1。
#DINGDA_E2E_MIN_PRODUCTS=1
# 等一轮跑完的上限（毫秒）。默认 600000。
#DINGDA_E2E_RUN_TIMEOUT_MS=600000
# 置 1 只验「发得出去、跑起来了、取消得掉」，不等结果。
#DINGDA_E2E_SEARCH_DRY_RUN=1
# 置 1 扫码用例只干跑（验点击链路，不占扫码窗口）。
#DINGDA_E2E_QR_DRY_RUN=1

# --- 打包 / 校验脚本 ---
# 用本地 camoufox zip（跳过下载）。仅在 scripts/prepare-desktop-runtime.mjs 里读。
#CAMOUFOX_ZIP=
# 固定 camoufox release tag（如 v152.0.4-beta.29）。
#CAMOUFOX_RELEASE_TAG=
# 置 1 强制重新下载 camoufox。
#FORCE_CAMOUFOX_FETCH=1
# 置 1 跳过打包 camoufox（仅开发）。
#SKIP_CAMOUFOX=1
# 置 1 跳过打包 uv。
#SKIP_UV_COPY=1
# 置 1 zip 缺失时直接失败（CI 上默认开）。
#REQUIRE_CAMOUFOX=1
# 提高 GitHub API 限额（拉 camoufox release 用）。
#GITHUB_TOKEN=
# 置任意值跳过「未使用导出」检查（如 SKIP_UNUSED_CHECK=1 pnpm dev）。
#SKIP_UNUSED_CHECK=1

# --- 网络 ---
# 走代理时把本机地址加进白名单，避免回打 Server / 推直播帧被代理拦掉。
# 本机实测：不设 NO_PROXY 时，若系统有 HTTP_PROXY，本地回打会绕一圈（可能 502）。
#NO_PROXY=127.0.0.1,localhost
#no_proxy=127.0.0.1,localhost

# ===========================================================================
# E. 系统变量（项目只读，**不要在这里改**，列出来只为完整性）
# ===========================================================================
# PATH / PATHEXT / SHELL        —— 解析外部 CLI 可执行文件
# ProgramFiles                  —— 找 Node / 已安装程序
# APPDATA / LOCALAPPDATA / HOME / USERPROFILE —— 定位数据目录与用户配置

# ===========================================================================
# 待办：还没接上本文件的三个读环境变量方
# ===========================================================================
# 1. **Tauri 壳**（Rust）—— 读 DINGDA_PORT / DINGDA_HOST / DINGDA_USE_UV /
#    DINGDA_UV / DINGDA_SERVER_DIR / DINGDA_CAMOUFOX_EXE。桌面模式下端口由它决定，
#    所以「在 .env 里改端口」目前对桌面端不生效。要接需加一个 Rust dotenv crate。
# 2. **Vite**（前端）—— 原生支持 .env，但根目录是 `apps/web/`，不读仓库根这份。
#    需要在 apps/web/vite.config.ts 里用 envDir 指过来。
# 3. **打包脚本**（scripts/*.mjs，CAMOUFOX_* / SKIP_* / GITHUB_TOKEN）—— 纯 Node，
#    需显式加载。这些一般只在 CI 或一次性打包时用，可不接。
