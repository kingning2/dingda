// DingDa 激活码签发（管理员本机工具，界面从简）

import { Button, LineEdit, TextEdit, ComboBox, ScrollView, GroupBox } from "std-widgets.slint";

export component ActivationGenWindow inherits Window {
    title: "DingDa 激活码签发";
    preferred-width: 760px;
    preferred-height: 720px;
    min-width: 560px;
    min-height: 480px;

    in-out property <string> machine-code: "";
    in-out property <string> duration-count-text: "30";
    in-out property <int> duration-unit-index: 0;
    in-out property <string> expiry-date-text: "";
    in-out property <string> product: "dingda";
    in-out property <string> version: "1";
    in-out property <string> private-key-path: "keys/private_key.pem";
    in-out property <string> output-path: "license.key";
    in-out property <string> token-preview: "";
    in-out property <string> status-message: "填写客户设备码和套餐时长后点击生成。到期时间自动计算，也可手动修改。";
    in-out property <bool> busy: false;

    callback generate-clicked();
    callback fill-local-machine-code();
    callback update-expiry();

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 28px;
            spacing: 20px;

            Text {
                text: "DingDa 激活码签发";
                font-size: 22px;
                font-weight: 700;
                horizontal-stretch: 0;
            }

            GroupBox {
                title: "客户设备";
                HorizontalLayout {
                    spacing: 12px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.machine-code;
                        placeholder-text: "粘贴客户设备码（客户机器上复制）";
                        enabled: !root.busy;
                    }
                    Button {
                        text: "读本机码";
                        enabled: !root.busy;
                        clicked => { root.fill-local-machine-code(); }
                    }
                }
            }

            GroupBox {
                title: "有效期";
                VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: stretch;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "套餐时长"; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.duration-count-text;
                                    enabled: !root.busy;
                                    edited => { root.update-expiry(); }
                                }
                                ComboBox {
                                    width: 110px;
                                    model: ["天", "个月", "年"];
                                    current-index <=> root.duration-unit-index;
                                    enabled: !root.busy;
                                    selected => { root.update-expiry(); }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "到期时间（自动计算，可手改）"; font-size: 12px; }
                            LineEdit {
                                text <=> root.expiry-date-text;
                                placeholder-text: "2026-12-31";
                                enabled: !root.busy;
                            }
                        }
                    }
                    Text {
                        text: "到期时间直接编入激活码，与客户何时首次激活无关。";
                        font-size: 11px;
                        opacity: 0.6;
                    }
                }
            }

            GroupBox {
                title: "产品信息";
                HorizontalLayout {
                    spacing: 16px;
                    alignment: stretch;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "产品"; font-size: 12px; }
                        LineEdit {
                            text <=> root.product;
                            enabled: !root.busy;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "版本"; font-size: 12px; }
                        LineEdit {
                            text <=> root.version;
                            enabled: !root.busy;
                        }
                    }
                }
            }

            GroupBox {
                title: "签发设置";
                VerticalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "私钥路径"; font-size: 12px; }
                        LineEdit {
                            text <=> root.private-key-path;
                            enabled: !root.busy;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "输出 .key 路径"; font-size: 12px; }
                        LineEdit {
                            text <=> root.output-path;
                            enabled: !root.busy;
                        }
                    }
                }
            }

            Button {
                text: root.busy ? "生成中…" : "生成激活码";
                primary: true;
                min-height: 44px;
                enabled: !root.busy;
                clicked => { root.generate-clicked(); }
            }

            GroupBox {
                title: "结果";
                VerticalLayout {
                    spacing: 8px;
                    TextEdit {
                        text <=> root.token-preview;
                        read-only: true;
                        wrap: word-wrap;
                        min-height: 96px;
                        vertical-stretch: 1;
                    }
                    Text {
                        text: root.status-message;
                        wrap: word-wrap;
                        font-size: 12px;
                        opacity: 0.7;
                    }
                }
            }
        }
    }
}
