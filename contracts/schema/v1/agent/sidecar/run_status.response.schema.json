{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://agent/sidecar/run_status.response/v1",
  "title": "agent/sidecar/run_status.response",
  "type": "object",
  "required": ["ok", "run_id", "state"],
  "properties": {
    "ok": { "type": "boolean" },
    "run_id": { "type": "string" },
    "state": { "type": "string" },
    "current_node": { "type": "string" },
    "completed_nodes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "run_step.schema.json" }
    },
    "reply": { "type": "string" },
    "error": { "type": "string" },
    "error_kind": { "type": "string" },
    "failed_node": { "type": "string" },
    "message": { "type": "string" }
  },
  "additionalProperties": false
}
