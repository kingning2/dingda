        "defaultPrice"
      ],
      "original_price": [
        "originalPrice"
      ],
      "want_count": [
        "wantCnt"
      ],
      "collect_count": [
        "collectCnt"
      ],
      "browse_count": [
        "browseCnt"
      ],
      "status": [
        "itemStatusStr"
      ],
      "seller_nick": [
        "nick",
        "uniqueName"
      ],
      "seller_id": [
        "sellerId"
      ],
      "location": [
        "publishCity",
        "city"
      ],
      "seller_score": [
        "xianyuSummary"
      ],
      "reply_ratio_24h": [
        "replyRatio24h"
      ],
      "reply_interval": [
        "replyInterval"
      ]
    },
    "label_names": {
      "condition": "成色",
      "brand": "品牌",
      "category": "分类"
    },
    "label_property_key": "propertyText",
    "label_text_key": "text",
    "image_url_key": "url"
  },
  "image": {
