    "need_login": false,
    "need_login_pc": false,
    "session_option": "AutoLoginOnly",
    "success_code": "SUCCESS",
    "data_item_id_key": "itemId",
    "fields": {
      "item_id": [
        "itemId"
      ],
      "title": [
        "title"
      ],
      "desc": [
        "desc"
      ],
      "sold_price": [
