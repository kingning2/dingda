# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/
.pytest_cache/
# 根 uv.lock 是 uv workspace 全量锁，CI `uv sync --frozen` / 桌面构建都靠它
!uv.lock
.dingda-skills/
.tmp/

# Desktop bundled runtime（prepare-desktop-runtime 产出；Camoufox zip 很大）
packages-rs/client/resources/runtime/

# E2E 的 msedgedriver（按 WebView2 版本下载，单份约 23MB，不进版本库）
e2e/.drivers/

# Rust
target/

# E2E 备用构建目录：dev 会话锁住 target/debug/client.exe 时的替代（见 e2e/README.md）
target-e2e/

# E2E 运行产物（扫码二维码快照等）
e2e/artifacts/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# pnpm 中断时可能留下的锁文件临时文件（0 字节，形如 _tmp_<pid>_<hash>）
_tmp_*

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.workbuddy-ai/*
.codegraph/*

# 本地环境变量（可能含 LLM / 服务端密钥）；需要模板时用 .env.example
.env
.env.*
!.env.example
