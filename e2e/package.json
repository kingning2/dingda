{
  "name": "@v2/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "桌面端 E2E：WebdriverIO 驱动内嵌 WebDriver 的 target/debug/client",
  "scripts": {
    "build:web": "pnpm --filter @v2/app-web build",
    "build:app": "cargo build -p client --features e2e",
    "build": "pnpm run build:web && pnpm run build:app",
    "e2e": "node ./scripts/run.mjs",
    "e2e:codex": "node ./scripts/run.mjs -- --spec ./specs/ai-codex-product.spec.ts",
    "e2e:orchestrate": "uv run --directory ../packages-py/api python scripts/e2e_orchestrate.py",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./scripts/run.mjs",
    "test:only": "node ./scripts/require-artifacts.mjs && wdio run wdio.conf.ts",
    "test:debug": "node ./scripts/run.mjs -- --logLevel debug"
  },
  "devDependencies": {
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "^9.31.2",
    "@types/node": "^22",
    "typescript": "~5.8.3"
  }
}
